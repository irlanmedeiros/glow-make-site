# ------------------------------------------------------------
# Banco de dados (obrigatório)
# ------------------------------------------------------------
# Postgres. Na Vercel: Storage > Create Database > Neon, que preenche sozinho.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ------------------------------------------------------------
# Admin (obrigatório)
# ------------------------------------------------------------
# Senha de acesso ao /admin. Mínimo 8 caracteres.
ADMIN_PASSWORD="troque-esta-senha"

# Senha que as VENDEDORAS usam. Abre só /catalogo (estoque ao vivo e baixa
# de venda no balcão) — nunca o painel administrativo. Mínimo 6 caracteres.
EQUIPE_PASSWORD="senha-da-equipe"

# Segredo que assina o cookie de sessão. Mínimo 16 caracteres.
# Gere com:  openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-por-um-aleatorio"

# ------------------------------------------------------------
# Asaas (opcional — sem isso o site roda em modo demonstração)
# ------------------------------------------------------------
# Sem a chave, pedidos e assinaturas são gravados e o estoque baixa
# normalmente, mas nenhuma cobrança é emitida.
#
# NUNCA cole a chave de verdade NESTE arquivo — ele é versionado. O lugar dela
# é o .env.local (que o git ignora) ou, em produção, a Vercel.
#
# A chave começa com cifrão ($aact_...) e o carregador de ambiente trata
# "$aact_..." como referência a variável, resolvendo para VAZIO. Sem erro
# nenhum: a chave simplesmente some e o site cai em modo demonstração. Aspas
# não resolvem — escape a cifra e não use aspas:
#
#     ASAAS_API_KEY=\$aact_hmlg_000Mzk...
#
# Na Vercel isso não acontece: variável do painel não passa por essa expansão.
#
# Em desenvolvimento use uma chave de SANDBOX (sandbox.asaas.com). Chave de
# produção na máquina faz qualquer teste de checkout virar cobrança real.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"          # sandbox | producao

# Token que você cadastra no painel do Asaas ao criar o webhook.
# Sem ele, a rota /api/asaas/webhook recusa todas as chamadas de propósito.
ASAAS_WEBHOOK_TOKEN=""

# ------------------------------------------------------------
# Frete (opcional — sem isso o pedido entra com "frete a combinar")
# ------------------------------------------------------------
# Token de API do melhorenvio.com.br. Entrega em João Pessoa é sempre
# grátis e não depende desta chave.
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_ENV="sandbox"   # sandbox | producao
