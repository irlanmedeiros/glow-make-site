// Glow Make — modelo de dados
// O estoque é a parte crítica: entradas e saidas são contadores acumulados e
// o saldo é sempre (entradas - saidas). A baixa acontece em SQL condicional
// dentro de transação, então dois pedidos simultâneos nunca vendem a mesma
// última unidade. Ver src/lib/estoque.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoProduto {
  KIT
  BOX
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum FormaPagamentoLoja {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
}

enum EtapaLead {
  CARRINHO       // montou o carrinho e parou
  DADOS          // começou a preencher o checkout
  CONTRATO       // leu o contrato da assinatura e não aceitou
}

enum StatusComissao {
  PENDENTE   // venda feita, pagamento ainda não confirmado
  APROVADA   // pagamento confirmado, comissão devida
  PAGA
  CANCELADA  // pedido cancelado ou estornado
}

enum StatusAssinante {
  AGUARDANDO_PAGAMENTO
  ATIVA
  ATRASADA
  CANCELADA
}

model Kit {
  id          String      @id @default(cuid())
  sku         String      @unique
  nome        String
  slug        String      @unique
  descricao   String
  itens       String[]
  preco       Decimal     @db.Decimal(10, 2)
  imagem      String
  tipo        TipoProduto @default(KIT)
  entradas    Int         @default(0)
  saidas      Int         @default(0)
  estoqueBaixo Int        @default(10)
  codigoBarras String?    @unique   // EAN da embalagem, para o leitor do balcão
  ativo       Boolean     @default(true)
  ordem       Int         @default(0)
  criadoEm    DateTime    @default(now())
  atualizadoEm DateTime   @updatedAt

  itensPedido PedidoItem[]
  itensVenda  VendaLojaItem[]

  @@index([ativo, ordem])
}

model Movimentacao {
  id       String           @id @default(cuid())
  sku      String
  nome     String
  tipo     TipoMovimentacao
  qtd      Int
  origem   String
  saldoApos Int
  criadoEm DateTime         @default(now())

  @@index([criadoEm])
  @@index([sku])
}

model Pedido {
  id       String       @id @default(cuid())
  numero   Int          @unique @default(autoincrement())
  nome     String
  email    String
  documento String
  telefone String

  // Endereço de entrega. Antes só existia o CEP, e não se entrega em um CEP.
  // Campos com default "" para a migração não quebrar pedidos antigos.
  cep            String
  endereco       String  @default("")
  enderecoNumero String  @default("")   // numero da casa; "numero" ja e o numero do pedido
  complemento String  @default("")
  bairro      String  @default("")
  cidade      String  @default("")
  uf          String  @default("")

  subtotal Decimal      @db.Decimal(10, 2)
  frete    Decimal      @db.Decimal(10, 2)
  total    Decimal      @db.Decimal(10, 2)
  pagamento String
  status   StatusPedido @default(AGUARDANDO_PAGAMENTO)
  asaasPaymentId String?
  invoiceUrl     String?
  observacao     String?
  estoqueDevolvido Boolean @default(false)

  // Origem da venda
  afiliadoId     String?
  afiliado       Afiliado? @relation(fields: [afiliadoId], references: [id], onDelete: SetNull)
  freteServico   String?   // "PAC", "SEDEX", "Grátis João Pessoa"

  // Logística
  transportadora String?
  codigoRastreio String?
  separadoEm     DateTime?
  enviadoEm      DateTime?
  entregueEm     DateTime?

  criadoEm DateTime     @default(now())
  atualizadoEm DateTime  @updatedAt

  itens PedidoItem[]

  @@index([criadoEm])
  @@index([status])
}

model PedidoItem {
  id       String  @id @default(cuid())
  pedidoId String
  pedido   Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  kitId    String?
  kit      Kit?    @relation(fields: [kitId], references: [id], onDelete: SetNull)
  sku      String
  nome     String
  preco    Decimal @db.Decimal(10, 2)
  qtd      Int

  @@index([pedidoId])
}

model Assinante {
  id        String          @id @default(cuid())
  nome      String
  email     String
  documento String
  telefone  String

  // A caixa também é entregue todo mês: precisa de endereço, não só de CEP.
  cep            String
  endereco       String @default("")
  enderecoNumero String @default("")
  complemento    String @default("")
  bairro         String @default("")
  cidade         String @default("")
  uf             String @default("")

  // Aceite do contrato: guarda quando, qual versão e de qual IP, porque um
  // aceite sem prova de quando aconteceu não serve para nada numa disputa.
  contratoVersao   String?
  contratoAceitoEm DateTime?
  contratoIp       String?

  afiliadoId String?
  afiliado   Afiliado? @relation(fields: [afiliadoId], references: [id], onDelete: SetNull)

  valor     Decimal         @db.Decimal(10, 2)
  status    StatusAssinante @default(AGUARDANDO_PAGAMENTO)
  asaasCustomerId     String?
  asaasSubscriptionId String?
  invoiceUrl          String?
  canceladaEm DateTime?
  criadoEm  DateTime        @default(now())
  atualizadoEm DateTime     @updatedAt

  @@index([status])
  @@index([criadoEm])
}

model Banner {
  id        String  @id @default(cuid())
  tag       String
  titulo    String
  subtitulo String
  imagem    String
  ctaTexto  String
  ctaLink   String
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  @@index([ativo, ordem])
}

model Depoimento {
  id     String  @id @default(cuid())
  nome   String
  cidade String
  tempo  String
  texto  String
  avatar String
  nota   Int     @default(5)
  ordem  Int     @default(0)
  ativo  Boolean @default(true)

  @@index([ativo, ordem])
}

model Foto {
  id     String  @id @default(cuid())
  url    String
  ordem  Int     @default(0)
  ativo  Boolean @default(true)

  @@index([ativo, ordem])
}

// Linha única (id = "config") com os ajustes gerais da loja.
model Config {
  id               String  @id @default("config")
  freteValor       Decimal @db.Decimal(10, 2) @default(24.90)
  freteGratisAcima Decimal @db.Decimal(10, 2) @default(199.00)
  avisos           String[]
  whatsapp         String  @default("(00) 00000-0000")
  email            String  @default("contato@glowmake.com.br")
  instagram        String  @default("@glowmake")
  cnpj             String  @default("00.000.000/0001-00")

  // Frete
  cidadeFreteGratis String  @default("João Pessoa")
  ufFreteGratis     String  @default("PB")
  cepOrigem         String  @default("58000-000")
  pesoPadraoKit     Decimal @db.Decimal(10, 3) @default(0.700)  // kg por kit

  // Marketing
  metaPixelId String @default("")

  // Contrato da assinatura
  contratoVersao String @default("v1")
  contratoTexto  String @default("")

  atualizadoEm     DateTime @updatedAt
}


// ============================================================
//  Afiliados — influenciadores que vendem por link próprio
// ============================================================
model Afiliado {
  id        String  @id @default(cuid())
  nome      String
  codigo    String  @unique   // vira glowmake.com.br/?ref=CODIGO
  email     String
  telefone  String  @default("")
  instagram String  @default("")
  documento String  @default("")
  chavePix  String  @default("")

  // Percentual por afiliado, não fixo no código: dá para negociar caso a caso
  // e para reduzir depois sem mexer em quem já está com o combinado antigo.
  percentual Decimal @db.Decimal(5, 2) @default(50.00)

  // Comissão da assinatura em todo mês de recorrência, e não só na adesão.
  recorrente Boolean @default(true)

  ativo    Boolean  @default(true)
  cliques  Int      @default(0)
  criadoEm DateTime @default(now())

  pedidos    Pedido[]
  assinantes Assinante[]
  comissoes  Comissao[]

  @@index([codigo])
}

model Comissao {
  id         String   @id @default(cuid())
  afiliadoId String
  afiliado   Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  origem      String   // "Pedido #12" ou "Assinatura de Fulana — agosto/2026"
  pedidoId    String?
  assinanteId String?

  // Guardamos a base e o percentual usados no momento da venda. Se o
  // percentual do afiliado mudar depois, o histórico não pode mudar junto.
  valorBase  Decimal @db.Decimal(10, 2)
  percentual Decimal @db.Decimal(5, 2)
  valor      Decimal @db.Decimal(10, 2)

  status   StatusComissao @default(PENDENTE)
  pagoEm   DateTime?
  criadoEm DateTime       @default(now())

  // Impede comissão duplicada: uma por pedido, e uma por assinante/mês.
  referencia String @unique

  @@index([afiliadoId, status])
  @@index([criadoEm])
}

// ============================================================
//  Leads — quem começou a comprar e não terminou
// ============================================================
model Lead {
  id       String    @id @default(cuid())
  etapa    EtapaLead @default(CARRINHO)

  nome     String @default("")
  email    String
  telefone String @default("")
  cep      String @default("")

  itens          Json     // o que estava no carrinho quando parou
  valorEstimado  Decimal  @db.Decimal(10, 2) @default(0)
  queriaAssinar  Boolean  @default(false)

  // Sem esse aceite não se manda WhatsApp nem e-mail de remarketing.
  consentiuContato Boolean   @default(false)
  consentidoEm     DateTime?

  afiliadoCodigo String?

  convertido   Boolean   @default(false)
  convertidoEm DateTime?

  contatado   Boolean   @default(false)
  contatadoEm DateTime?
  anotacao    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([email])
  @@index([convertido, criadoEm])
}


// ============================================================
//  PDV — vendas feitas no balcão da loja física
// ============================================================

/**
 * Antes, vender no balcão só baixava o estoque. O dinheiro não era gravado em
 * lugar nenhum, então o faturamento da loja física era invisível no painel.
 * Esta tabela existe para a venda física ser uma VENDA, com valor e forma de
 * pagamento, e não apenas um movimento de estoque.
 */
model VendaLoja {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  vendedora      String
  formaPagamento FormaPagamentoLoja

  subtotal Decimal @db.Decimal(10, 2)
  desconto Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2)

  observacao  String?
  cancelada   Boolean   @default(false)
  canceladaEm DateTime?
  motivoCancelamento String?

  // A venda nasce ligada ao caixa aberto no momento. É isso que permite
  // fechar o dia e conferir o que entrou por forma de pagamento.
  caixaId String?
  caixa   Caixa?  @relation(fields: [caixaId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  itens VendaLojaItem[]

  @@index([criadoEm])
  @@index([caixaId])
}

model VendaLojaItem {
  id      String    @id @default(cuid())
  vendaId String
  venda   VendaLoja @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  kitId String?
  kit   Kit?    @relation(fields: [kitId], references: [id], onDelete: SetNull)

  // Nome e preço são copiados no momento da venda: se o produto mudar de
  // preço amanhã, a venda de hoje não pode mudar junto.
  sku   String
  nome  String
  preco Decimal @db.Decimal(10, 2)
  qtd   Int

  @@index([vendaId])
}

/** Sessão de caixa: da abertura ao fechamento do dia. */
model Caixa {
  id         String    @id @default(cuid())
  abertoEm   DateTime  @default(now())
  abertoPor  String
  trocoInicial Decimal @db.Decimal(10, 2) @default(0)

  fechadoEm  DateTime?
  fechadoPor String?

  // Quanto a pessoa CONTOU na gaveta ao fechar. A diferença para o esperado
  // é o que revela erro de troco ou venda não registrada.
  contadoDinheiro Decimal? @db.Decimal(10, 2)
  observacao      String?

  vendas VendaLoja[]

  @@index([abertoEm])
}
